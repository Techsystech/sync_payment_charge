<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_inherit_sync_payment_charge" model="ir.ui.view">
        <field name="name">Payment Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="before">
                <field name="support_fees" invisible="1" />
            </xpath>
            <xpath expr="//notebook/page[@name='messages']" position="before">
                <page string="Fees" name="fees" invisible="not support_fees">
                    <group name="payment_fees" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
